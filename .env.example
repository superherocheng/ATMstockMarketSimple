# ════════════════════════════════════════════════════
# ATMstockMarket — VPS 部署环境变量配置模板
# ════════════════════════════════════════════════════
# 使用方法:
#   1. 复制此文件:  cp .env.example .env
#   2. 填入你的配置
#   3. 启动:        docker compose up -d
# ════════════════════════════════════════════════════

# ── 必填 ────────────────────────────────────────────
# Tushare Pro Token（获取: https://tushare.pro/register）
TUSHARE_TOKEN=your_tushare_token_here

# ── 数据库（默认值已适配 docker-compose，通常无需修改）──
# 如果使用外部数据库，修改此连接串
DATABASE_URL=postgresql://postgres:password@db:5432/atm_stock_market

# ── PostgreSQL 默认凭据（仅首次创建数据库时使用）───
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=atm_stock_market

# ── Redis 缓存（默认值已适配 docker-compose）───────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── Authentication ──────────────────────────────────
# Authentication token for write endpoints (REQUIRED for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change_me_to_a_strong_random_token

# ── CORS (frontend origins) ─────────────────────────
# Comma-separated list of allowed browser origins for the React SPA.
# Drives BOTH CORS preflight and the CSRF allow-list (so POST write-ops
# from the SPA are not 403'd). The Vite dev server is always allowed.
# Add production domain(s), e.g. CORS_ORIGINS=https://atm.example.com
CORS_ORIGINS=http://localhost:5173

# ── Frontend write-op token ─────────────────────────
# The React SPA needs the SAME token baked in at build time (Vite reads
# import.meta.env.VITE_API_TOKEN). For single-token deployments set API_TOKEN
# (above) and VITE_API_TOKEN to the same value, then:
#   VITE_API_TOKEN=<same_token> npm run build
# Without this, every POST (/api/fetch/*, /api/cache/invalidate, ...) 401s in prod.
VITE_API_TOKEN=change_me_to_a_STRONG_random_token

# ── Internal service URL ────────────────────────────
# Where the web API is reachable from the fetcher/data processes (used by
# tushare_fetcher to POST /api/cache/invalidate after a share update).
# Docker compose: http://web:5656 ; single-host: http://127.0.0.1:5656
WEB_INTERNAL_URL=http://localhost:5656

# ── Web server port ─────────────────────────────────
# uvicorn port + CSRF allow-list default. Change one place, not three.
PORT=5656

# ── 其他可选配置 ────────────────────────────────────
# TZ=Asia/Shanghai
# LOG_LEVEL=info

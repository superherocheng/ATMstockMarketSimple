# ════════════════════════════════════════════════════
# ATMstockMarket — VPS 部署环境变量配置模板
# ════════════════════════════════════════════════════
# 使用方法:
#   1. 复制此文件:  cp .env.example .env
#   2. 填入你的配置
#   3. 启动:        docker compose up -d
# ════════════════════════════════════════════════════

# ── 必填 ────────────────────────────────────────────
# Tushare Pro Token（获取: https://tushare.pro/register）
TUSHARE_TOKEN=your_tushare_token_here

# ── 数据库（默认值已适配 docker-compose，通常无需修改）──
# 如果使用外部数据库，修改此连接串
DATABASE_URL=postgresql://postgres:password@db:5432/atm_stock_market

# ── PostgreSQL 默认凭据（仅首次创建数据库时使用）───
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=atm_stock_market

# ── Redis 缓存（默认值已适配 docker-compose）───────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── 其他可选配置 ────────────────────────────────────
# TZ=Asia/Shanghai
# LOG_LEVEL=info
